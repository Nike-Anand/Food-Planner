# Food ordering uses local sample dishes and browser storage.
# The root entry point runs the Flagsmith food-discovery experiment.
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_ID=

# Feature 2: Cook It Yourself (Supabase dish and ingredient API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Flagsmith key for the cook_yourself_enabled recipe gate.
FLAGSMITH_SERVER_KEY=
